# Copy to .env.local for local dev. NEVER commit .env or .env.local.
# Supabase: get from https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# EAS project ID — required for push notifications on physical devices.
# Run `eas init` to create/link a project, then paste the UUID here.
EAS_PROJECT_ID=your-eas-project-id-here
